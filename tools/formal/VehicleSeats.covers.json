{
  "skill": ".agents/skills/verify-vehicle-seats/SKILL.md",
  "note": "stepVehicle and stepTumble (tipping, sinking) are not regions on purpose: the model lets any vehicle tip or sink at any time, so their physics may change without a re-check. A seat or rider write added there still fails the writes check.",
  "regions": [
    "shared/sim/vehicle.ts#freeSeat",
    "shared/sim/vehicle.ts#enterVehicle",
    "shared/sim/vehicle.ts#exitVehicle",
    "shared/sim/vehicle.ts#switchSeat",
    "shared/sim/vehicle.ts#takeSeat",
    "shared/sim/vehicle.ts#flipVehicle",
    "shared/sim/vehicle.ts#stepRighting",
    "shared/sim/vehicle.ts#spawnVehicle",
    "shared/sim/vehicle.ts#VehicleSet.reset",
    "shared/sim/vehicle.ts#RIDE_ST",
    "shared/sim/match.ts#Match.useVehicle",
    "shared/sim/match.ts#Match.ejectAll",
    "shared/sim/match.ts#Match.tukEvents",
    "shared/sim/match.ts#Match.blowTuk",
    "shared/sim/match.ts#Match.stepVehicles",
    "shared/sim/match.ts#Match.spawnTuks",
    "shared/sim/match.ts#Match.kill",
    "shared/sim/match.ts#Match.enterWarmup",
    "shared/sim/match.ts#Match.enterPlane",
    "shared/sim/match.ts#Match.stepRespawns",
    "shared/sim/match.ts#Match.spawnWarmup",
    "shared/sim/match.ts#Match.spawnAt",
    "shared/sim/player.hot.ts#stepRide",
    "shared/sim/player.ts#resetForMatch"
  ],
  "writes": [
    {
      "what": "a vehicle's seats, a rider's vehicle and seat, and every kong-state write (a rider leaves the Ride state only together with its seat); vehicle states (VS.*) are not kong states",
      "pattern": "seats\\[[^\\]]*\\]\\s*=(?!=)\\s*[\\w.-]+|\\.(veh|seat)\\s*=(?!=)\\s*[\\w.-]+|\\.st\\s*=(?!=)(?!\\s*VS\\.)\\s*[\\w.]+",
      "files": [
        "shared/sim/",
        "shared/net/",
        "server/"
      ]
    }
  ],
  "allow": [
    {
      "at": "shared/sim/vehicle.ts#VehicleSet.bind",
      "writes": [
        ".veh = this"
      ],
      "why": "world.veh is the vehicle set, not a rider's vehicle"
    },
    {
      "at": "shared/net/proto.ts#readSelf",
      "writes": [
        ".seat = r.u8",
        ".st = r.u8",
        ".veh = vi"
      ],
      "why": "decodes a snapshot into the client's copy of its own kong; the server's seats are what the model checks"
    },
    {
      "at": "shared/net/proto.ts#readPlayer",
      "writes": [
        ".seat = 0",
        ".seat = s",
        ".st = 8",
        ".st = 9",
        ".st = b"
      ],
      "why": "decodes a snapshot into the client's copy of another kong"
    },
    {
      "at": "server/lobby.ts#Lobby.castJoin",
      "writes": [
        ".seat = seat"
      ],
      "why": "a commentator seat (Client.seat), not a vehicle seat"
    },
    {
      "at": "server/lobby.ts#Lobby.castLeave",
      "writes": [
        ".seat = -1"
      ],
      "why": "a commentator seat (Client.seat), not a vehicle seat"
    },
    {
      "at": "shared/sim/player.hot.ts#stepPlayer",
      "writes": [
        ".st = PS.Glide"
      ],
      "why": "its state writes come after the Ride early return, so they never touch a rider"
    },
    {
      "at": "shared/sim/player.hot.ts#tryMantle",
      "writes": [
        ".st = PS.Mantle"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/player.hot.ts#stepMantle",
      "writes": [
        ".st = PS.Ground"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
