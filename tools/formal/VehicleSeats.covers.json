    },
    {
      "at": "shared/sim/match.ts#Match.setupRange",
      "writes": [
        ".st = PS.Spectate"
      ],
      "why": "the firing range has no vehicles"
    },
    {
      "at": "shared/sim/match.ts#Match.placeDummy",
      "writes": [
        ".st = PS.Ground"
      ],
      "why": "the firing range has no vehicles"
    },
    {
      "at": "shared/sim/match.ts#Match.spawnShooter",
      "writes": [
        ".st = PS.Ground"
      ],
      "why": "the firing range has no vehicles"
    },
    {
      "at": "shared/sim/zipline.ts#zipAttach",
      "writes": [
        ".st = ZIP_ST"
      ],
      "why": "grabs a trolley only from on foot (returns early unless p.st === 0)"
    },
    {
      "at": "shared/sim/zipline.ts#toFoot",
      "writes": [
        ".st = 0"
      ],
      "why": "called only from the zipline step, for a kong riding a cable, never a vehicle"
    },
    {
      "at": "shared/net/proto.ts#readVehicle",
      "writes": [
        ".st = sb"
      ],
      "why": "decodes a snapshot into the client's copy of a vehicle"
    }
  ],
