      "writes": [
        ".st = PS.Mantle"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/player.hot.ts#stepVault",
      "writes": [
        ".st = PS.Ground"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/player.hot.ts#grabClimb",
      "writes": [
        ".st = PS.Climb"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/player.hot.ts#leaveClimb",
      "writes": [
        ".st = PS.Ground"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/player.hot.ts#stepClimb",
      "writes": [
        ".st = PS.Mantle"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/player.hot.ts#stepAir",
      "writes": [
        ".st = PS.Freefall",
        ".st = PS.Glide",
        ".st = PS.Ground"
      ],
      "why": "runs only from stepPlayer's on-foot and air branches, after it hands a riding kong to stepRide and returns (player.hot.ts: if (p.st === PS.Ride) ... return)"
    },
    {
      "at": "shared/sim/plane.ts#planeExit",
      "writes": [
