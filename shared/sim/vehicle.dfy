// Generated by lsc from vehicle.ts

type VS(==)

datatype Vehicle = Vehicle(id: int, st: VS, seats: seq<int>)

datatype Rider = Rider(id: int, seat: int)

method freeSeat(v: Vehicle, team: int, teamOf: (int) -> int) returns (res: int)
  requires (|v.seats| == 3)
  ensures (res >= -1)
  ensures (res < 3)
  ensures ((res >= 0) ==> (v.seats[res] < 0))
  ensures ((res >= 0) ==> forall j: int :: ((0 <= j) ==> (j < res) ==> (v.seats[j] >= 0)))
  ensures ((res >= 0) ==> forall j: int :: ((0 <= j) ==> (j < 3) ==> (v.seats[j] >= 0) ==> (teamOf(v.seats[j]) == team)))
{
  var i_t0: bool := *;
  if i_t0 {
    return -1;
  }
  var k := 0;
  while (k < 3)
    invariant (0 <= k)
    invariant (k <= 3)
    invariant forall j: int :: ((0 <= j) ==> (j < k) ==> (v.seats[j] >= 0) ==> (teamOf(v.seats[j]) == team))
  {
    if ((v.seats[k] >= 0) && (teamOf(v.seats[k]) != team)) {
      return -1;
    }
    k := (k + 1);
  }
  var k_2 := 0;
  while (k_2 < 3)
    invariant (0 <= k_2)
    invariant (k_2 <= 3)
    invariant forall j: int :: ((0 <= j) ==> (j < k_2) ==> (v.seats[j] >= 0))
  {
    if (v.seats[k_2] < 0) {
      return k_2;
    }
    k_2 := (k_2 + 1);
  }
  return -1;
}
